<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <!-- Build writes the OpenAPI document that packages/api-client generates its types from. -->
    <OpenApiDocumentsDirectory>$(MSBuildThisFileDirectory)..\..\..\packages\api-client\openapi</OpenApiDocumentsDirectory>
    <OpenApiGenerateDocumentsOptions>--file-name ffm-api</OpenApiGenerateDocumentsOptions>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\FFM.Application\FFM.Application.csproj" />
    <ProjectReference Include="..\FFM.Infrastructure\FFM.Infrastructure.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="FFM.UnitTests" />
  </ItemGroup>
</Project>
